{
  "name": "lokibox",
  "private": true,
  "version": "2.5.4",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev-bypass": "vite build --mode dev-bypass",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build:desktop-plugin": "vite build --mode dev-bypass --config vite.desktop.config.ts",
    "desktop:start": "pnpm build:desktop-plugin && electron .",
    "desktop:package": "pnpm build:desktop-plugin && electron-builder --win --x64"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tsconfig/svelte": "^5.0.5",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.19",
    "javascript-obfuscator": "^5.4.3",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-monkey": "^7.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "lucide-svelte": "^0.577.0",
    "path": "^0.12.7",
    "sass-embedded": "^1.92.1",
    "terser": "^5.48.0",
    "url": "^0.11.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  },
  "build": {
    "appId": "fun.dao3.lokibox.browser",
    "productName": "LokiBox Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist-desktop/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}